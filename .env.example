# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# PAYMENT_SIGNING_SECRET: Optional secret for signing server-side payment intents.
PAYMENT_SIGNING_SECRET="CHANGE_ME_IN_PRODUCTION"

# RAZORPAY_KEY_ID & RAZORPAY_KEY_SECRET: Optional live/test keys from Razorpay Dashboard.
# When set, checkout opens Razorpay Checkout and verifies signatures via HMAC-SHA256.
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""

# STRIPE_SECRET_KEY: Optional live/test secret key from Stripe Dashboard.
# When set, Stripe payments create and verify real Stripe PaymentIntents server-side.
STRIPE_SECRET_KEY=""

# DEPOT_MANAGER_EMAIL: Recipient email for new customer order alerts.
DEPOT_MANAGER_EMAIL="pushpendra.rawat2025@gmail.com"

# Email Delivery (configure ONE of Resend, Gmail App Password, or custom SMTP in Secrets):
RESEND_API_KEY=""
RESEND_FROM_EMAIL=""
GMAIL_USER=""
GMAIL_APP_PASSWORD=""
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM=""

